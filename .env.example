# ResearchPilot Edge - Configuration
# Private AI Research Assistant for Snapdragon-powered HP PCs

# Application Mode: local, edge, offline
APP_ENV=local
OFFLINE_MODE=true
LOG_LEVEL=INFO

# Execution Backend Preference: auto, onnx, qualcomm_ai_hub, transformers, cpu
PREFERRED_BACKEND=auto

# Inference & Generation Model Configuration
# Options: Phi-3-mini-4k-instruct, Qwen2.5-0.5B-Instruct, Qwen2.5-1.5B-Instruct, Gemma-2-2b-it
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MAX_GENERATION_TOKENS=512
TEMPERATURE=0.2

# Embedding Model Configuration
# Options: sentence-transformers/all-MiniLM-L6-v2, BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Store & RAG Retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35

# Qualcomm AI Hub API (Optional for cloud compilation / profiling)
QAI_HUB_API_TOKEN=
